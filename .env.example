# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_URL=http://localhost:3000
JOB_SECRET=change-me-32-chars-minimum-random-string
ENCRYPTION_KEY=                     # 32 bytes, base64 (openssl rand -base64 32)
ALLOW_WORKSPACE_CREATION=true       # lets a signed-in user without a workspace create one (dev / first run)

# Meta (Phase 3)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v21.0

# Unite (Phase 6, read-only)
UNITE_BASE_URL=https://ucexternalapiprod.uniteuae.care/gateway/
UNITE_APP_ID=
UNITE_APP_KEY=

# Migration / audit only; remove after cut-over
AIRTABLE_PAT=
MAKE_API_TOKEN=
MAKE_ZONE=us2
MAKE_TEAM_ID=1494412

# AI (Phase 10)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EMBEDDINGS_API_KEY=
EMBEDDINGS_PROVIDER=voyage          # voyage | fake (fake = deterministic, local/tests only)
EMBEDDINGS_MODEL=voyage-3           # must output 1024 dims to match kb_chunks.embedding vector(1024)

# Web Push (Phase 13): generate with `pnpm push:keys`. The public key is not secret, the private key is.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@your-clinic.example

# Email
RESEND_API_KEY=
RESEND_FROM="Pulse <no-reply@example.com>"   # use a sender on your verified Resend domain in production

# Error reporting (Sentry). Leave empty and Sentry is off: the SDK is not loaded at all.
# Events are scrubbed before they leave (lib/observability/scrub.ts): no bodies, cookies, query strings or e-mails.
SENTRY_DSN=                         # server and middleware errors
NEXT_PUBLIC_SENTRY_DSN=             # browser errors; read at BUILD time (usually the same DSN), so rebuild after changing it
# Source-map upload during `next build`: only when all three are set (CI / Vercel build env, never in the browser).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Tests: a plain Postgres with supabase/test stubs (see scripts/test-db.sh)
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/pulse_test
