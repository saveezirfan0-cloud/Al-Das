{
  "flow": [
    {
      "id": 1,
      "mapper": {},
      "module": "gateway:CustomWebHook",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      },
      "parameters": {
        "hook": null,
        "maxResults": 1
      }
    },
    {
      "id": 2,
      "filter": {
        "name": "Insurance keyword matched",
        "conditions": [
          [
            {
              "a": "{{1.message_text}}",
              "b": "insurance|insured|coverage|network|co-pay|copay|deductible|claim|policy number|member id|card|thiqa|daman|adnic|oman|axa|metlife|cigna|bupa|allianz|saico|ngi",
              "o": "text:match:ci"
            }
          ]
        ]
      },
      "mapper": {
        "base": "appZbwlQvkuaUsF2l",
        "table": "tblTBD_InsuranceVerification",
        "record": {
          "Phone": "{{1.contact_phone}}",
          "Patient Name": "{{1.contact_name}}",
          "Request Time": "{{now}}",
          "SLA Deadline": "{{addMinutes(now; 5)}}",
          "Insurance Provider": "{{1.message_text}}",
          "Verification Status": "Pending"
        },
        "useColumnId": false
      },
      "module": "airtable:ActionCreateRecord",
      "version": 3,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "parameters": {
        "__IMTCONN__": 6448605
      }
    },
    {
      "id": 3,
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "https://developers.sanoflow.io/api/v1.1/messages/whatsapp/send-template",
        "data": "{\n  \"template_id\": \"TEMPLATE_ID_insurance_received\",\n  \"phone\": \"{{1.contact_phone}}\",\n  \"mapper_value\": [\"{{1.contact_name}}\", \"insurance provider TBD\"]\n}",
        "gzip": true,
        "method": "post",
        "headers": [
          {
            "name": "Content-type",
            "value": "application/json"
          },
          {
            "name": "access-token",
            "value": "[REDACTED]"
          }
        ],
        "timeout": "",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "raw",
        "contentType": "application/json",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": true,
        "useQuerystring": false,
        "followAllRedirects": true,
        "rejectUnauthorized": true
      },
      "module": "http:ActionSendData",
      "version": 3,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "parameters": {}
    },
    {
      "id": 4,
      "mapper": {
        "duration": "300"
      },
      "module": "util:FunctionSleep",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      },
      "parameters": {}
    },
    {
      "id": 5,
      "mapper": {
        "id": "{{2.id}}",
        "base": "appZbwlQvkuaUsF2l",
        "table": "tblTBD_InsuranceVerification"
      },
      "module": "airtable:ActionGetRecord",
      "version": 3,
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      },
      "parameters": {
        "__IMTCONN__": 6448605
      }
    },
    {
      "id": 6,
      "filter": {
        "name": "Still Pending (SLA breached)",
        "conditions": [
          [
            {
              "a": "{{5.`Verification Status`}}",
              "b": "Pending",
              "o": "text:equal"
            }
          ]
        ]
      },
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "https://developers.sanoflow.io/api/v1.1/messages/whatsapp/send-text",
        "data": "{\"phone\": \"COORDINATOR_PHONE_TBD\", \"channel_id\": \"CHANNEL_COMMS_TBD\", \"message\": \"SLA BREACH: Insurance verification for {{1.contact_name}} has exceeded 5 minutes. Please verify immediately.\"}",
        "gzip": true,
        "method": "post",
        "headers": [
          {
            "name": "Content-type",
            "value": "application/json"
          },
          {
            "name": "access-token",
            "value": "[REDACTED]"
          }
        ],
        "timeout": "",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "raw",
        "contentType": "application/json",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": true,
        "useQuerystring": false,
        "followAllRedirects": true,
        "rejectUnauthorized": true
      },
      "module": "http:ActionSendData",
      "version": 3,
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      },
      "parameters": {}
    }
  ],
  "name": "DRAFT - Insurance Verification Express",
  "metadata": {
    "instant": true,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "dlq": false,
      "slots": null,
      "dataloss": false,
      "maxErrors": 3,
      "autoCommit": true,
      "roundtrips": 1,
      "sequential": false,
      "confidential": false,
      "freshVariables": false,
      "autoCommitTriggerLast": true
    }
  }
}