{
  "_comment": "Synthetic parity cases for the finance access window: financeAccessDecision() (lib/security/finance-access.ts) and app.finance_window_reason() (SQL) must both give `expect`. The request address is always 203.0.113.7 (documentation range); SQL never evaluates addresses, so address-list cases here only use lists that contain it. 2026-10-12 is a Monday; Asia/Dubai is UTC+4 all year; Europe/London changes clocks on 2026-03-29 and 2026-10-25. Cases whose `cfg` the database refuses to store (app.finance_access_problem) are compared by that refusal instead.",
  "roleId": "11111111-1111-4111-8111-111111111111",
  "otherRoleId": "22222222-2222-4222-8222-222222222222",
  "cases": [
    {
      "name": "nothing stored",
      "cfg": null,
      "now": "2026-10-18T22:00:00Z",
      "expect": "off"
    },
    {
      "name": "switched off",
      "cfg": {
        "enabled": false
      },
      "now": "2026-10-18T22:00:00Z",
      "expect": "off"
    },
    {
      "name": "switched off but malformed: off wins",
      "cfg": {
        "enabled": false,
        "days": "weekdays",
        "start": 7
      },
      "now": "2026-10-18T22:00:00Z",
      "expect": "off"
    },
    {
      "name": "enabled and malformed days",
      "cfg": {
        "enabled": true,
        "days": "weekdays"
      },
      "expect": "invalid_settings"
    },
    {
      "name": "enabled not a boolean",
      "cfg": {
        "enabled": "yes"
      },
      "expect": "invalid_settings"
    },
    {
      "name": "enabled null",
      "cfg": {
        "enabled": null
      },
      "expect": "invalid_settings"
    },
    {
      "name": "not an object",
      "cfg": [1, 2],
      "expect": "invalid_settings"
    },
    {
      "name": "bad start time",
      "cfg": {
        "enabled": true,
        "start": "7:00"
      },
      "expect": "invalid_settings"
    },
    {
      "name": "day out of range",
      "cfg": {
        "enabled": true,
        "days": [0, 1]
      },
      "expect": "invalid_settings"
    },
    {
      "name": "fractional day",
      "cfg": {
        "enabled": true,
        "days": [1.5]
      },
      "expect": "invalid_settings"
    },
    {
      "name": "eight days",
      "cfg": {
        "enabled": true,
        "days": [1, 1, 2, 3, 4, 5, 6, 7]
      },
      "expect": "invalid_settings"
    },
    {
      "name": "no days while enabled",
      "cfg": {
        "enabled": true,
        "days": []
      },
      "expect": "invalid_settings"
    },
    {
      "name": "bad address",
      "cfg": {
        "enabled": true,
        "ip_allowlist": ["office"]
      },
      "expect": "invalid_settings"
    },
    {
      "name": "every-address range",
      "cfg": {
        "enabled": true,
        "ip_allowlist": ["0.0.0.0/0"]
      },
      "expect": "invalid_settings"
    },
    {
      "name": "bad scope",
      "cfg": {
        "enabled": true,
        "scope": "everyone"
      },
      "expect": "invalid_settings"
    },
    {
      "name": "bad role id",
      "cfg": {
        "enabled": true,
        "role_ids": ["not-a-uuid"]
      },
      "expect": "invalid_settings"
    },
    {
      "name": "only these roles, none, enabled",
