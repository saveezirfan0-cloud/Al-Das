{
  "settings": { "toleranceAmount": 0.5, "tolerancePct": 0, "windowDays": 14, "refMinLength": 4, "setMaxItems": 4, "itemLookBackDays": 60 },
  "cases": [
    { "name": "partial payment: bank paid 20 of 120",
      "autoRules": ["reference", "payer_sum"],
      "receipts": [{ "paymentRef": "RA-0001", "payerKey": "PAYER-A", "amount": 120, "date": "2026-09-01" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 20, "text": "TRANSFER RA-0001" }],
      "expect": [{ "lineId": "L1", "rule": "reference", "options": 1, "auto": false, "allocs": [["ins|RA0001", 20]], "itemsLeft": 100, "lineLeft": 0 }] },
    { "name": "reference present but short pay",
      "autoRules": ["reference"],
      "receipts": [{ "paymentRef": "RA-0002", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 90, "text": "RA-0002" }],
      "expect": [{ "lineId": "L1", "rule": "reference", "options": 1, "auto": false, "allocs": [["ins|RA0002", 90]], "itemsLeft": 10 }] },
    { "name": "surplus pay: the extra stays on the line",
      "autoRules": ["reference"],
      "receipts": [{ "paymentRef": "RA-0003", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 130, "text": "RA-0003" }],
      "expect": [{ "lineId": "L1", "rule": "reference", "options": 1, "auto": false, "allocs": [["ins|RA0003", 100]], "lineLeft": 30 }] },
    { "name": "one deposit pays several references",
      "autoRules": ["reference"],
      "receipts": [
        { "paymentRef": "RA-0004", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" },
        { "paymentRef": "RA-0005", "payerKey": "PAYER-A", "amount": 50, "date": "2026-09-02" }
      ],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 150, "text": "PAYER-A RA-0004 RA-0005" }],
      "expect": [{ "lineId": "L1", "rule": "reference", "options": 1, "auto": true, "allocs": [["ins|RA0004", 100], ["ins|RA0005", 50]] }] },
    { "name": "one reference paid in two parts: the second line completes it",
      "autoRules": ["reference"],
      "receipts": [{ "paymentRef": "RA-0006", "payerKey": "PAYER-A", "amount": 120, "date": "2026-09-01" }],
      "allocated": { "ins|RA0006": 20 },
      "lines": [{ "id": "L2", "valueDate": "2026-09-20", "open": 100, "text": "RA-0006" }],
      "expect": [{ "lineId": "L2", "rule": "reference", "options": 1, "auto": true, "allocs": [["ins|RA0006", 100]], "itemsLeft": 0 }] },
    { "name": "resubmission paid in a later month (remittance batch only)",
      "autoRules": ["reference"],
      "batches": [{ "id": "b1000000-0000-0000-0000-000000000001", "refKey": "RA0007", "payerKey": "payer-a", "date": "2026-07-01", "sumPaid": 80 }],
      "lines": [{ "id": "L1", "valueDate": "2026-10-05", "open": 80, "text": "RA-0007" }],
      "expect": [{ "lineId": "L1", "rule": "reference", "options": 1, "auto": true, "allocs": [["ins|RA0007", 80]] }] },
    { "name": "late payment months after the receipt date",
      "autoRules": ["reference"],
      "receipts": [{ "paymentRef": "RA-0008", "payerKey": "PAYER-A", "amount": 200, "date": "2026-05-01" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-20", "open": 200, "text": "RA-0008" }],
      "expect": [{ "lineId": "L1", "rule": "reference", "options": 1, "auto": true, "allocs": [["ins|RA0008", 200]] }] },
    { "name": "duplicate amount, two payers: ambiguous, never auto",
      "autoRules": ["reference", "payer_sum"],
      "receipts": [
        { "paymentRef": "RA-0009", "payerKey": "PAYER-A", "amount": 75, "date": "2026-09-05" },
        { "paymentRef": "RB-0001", "payerKey": "PAYER-B", "amount": 75, "date": "2026-09-05" }
      ],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 75, "text": "UNKNOWN SENDER" }],
      "expect": [{ "lineId": "L1", "rule": "amount_date", "options": 2, "auto": false }] },
    { "name": "same payer, two items of the same amount: ambiguous, never auto",
      "autoRules": ["reference", "payer_sum"],
      "receipts": [
        { "paymentRef": "RA-0010", "payerKey": "PAYER-A", "amount": 50, "date": "2026-09-01" },
        { "paymentRef": "RA-0011", "payerKey": "PAYER-A", "amount": 50, "date": "2026-09-02" }
      ],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 50, "text": "PAYER-A" }],
      "expect": [{ "lineId": "L1", "rule": "payer_sum", "options": 2, "auto": false }] },
    { "name": "unmatched deposit gives no suggestion",
      "autoRules": ["reference", "payer_sum"],
      "receipts": [{ "paymentRef": "RA-0012", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 999, "text": "SOMETHING ELSE" }],
      "expect": [] },
    { "name": "a rejected pair is not offered again by any rule",
      "autoRules": ["reference", "payer_sum"],
      "receipts": [{ "paymentRef": "RA-0013", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" }],
      "rejected": ["ins|RA0013|L1"],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 100, "text": "PAYER-A RA-0013" }],
      "expect": [] },
    { "name": "payer recognised only through an approved alias",
      "autoRules": ["payer_sum"],
      "receipts": [{ "paymentRef": "RA-0014", "payerKey": "PAYER-A", "amount": 60, "date": "2026-09-01" }],
      "aliases": [{ "id": "alias-1", "payerKey": "PAYER-A", "alias": "ACME HEALTH" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 60, "text": "ACME HEALTH TRANSFER 77" }],
      "expect": [{ "lineId": "L1", "rule": "payer_sum", "options": 1, "auto": true, "aliasId": "alias-1", "allocs": [["ins|RA0014", 60]] }] },
    { "name": "without an approved alias the same narrative only gets amount and date, never auto",
      "autoRules": ["reference", "payer_sum"],
      "receipts": [{ "paymentRef": "RA-0015", "payerKey": "PAYER-A", "amount": 60, "date": "2026-09-01" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 60, "text": "ACME HEALTH TRANSFER 77" }],
      "expect": [{ "lineId": "L1", "rule": "amount_date", "options": 1, "auto": false }] },
    { "name": "a set of three payments adds up to the deposit",
      "autoRules": ["payer_sum"],
      "receipts": [
        { "paymentRef": "RA-0016", "payerKey": "PAYER-A", "amount": 30, "date": "2026-09-01" },
        { "paymentRef": "RA-0017", "payerKey": "PAYER-A", "amount": 45, "date": "2026-09-02" },
        { "paymentRef": "RA-0018", "payerKey": "PAYER-A", "amount": 25.5, "date": "2026-09-03" }
      ],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 100.5, "text": "PAYER-A" }],
      "expect": [{ "lineId": "L1", "rule": "payer_sum", "options": 1, "auto": true, "allocs": [["ins|RA0016", 30], ["ins|RA0017", 45], ["ins|RA0018", 25.5]] }] },
    { "name": "two lines compete for one item: neither is automatic",
      "autoRules": ["reference"],
      "receipts": [{ "paymentRef": "RA-0019", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" }],
      "lines": [
        { "id": "L1", "valueDate": "2026-09-10", "open": 100, "text": "RA-0019" },
        { "id": "L2", "valueDate": "2026-09-11", "open": 100, "text": "RA-0019" }
      ],
      "expect": [
        { "lineId": "L1", "rule": "reference", "options": 1, "auto": false },
        { "lineId": "L2", "rule": "reference", "options": 1, "auto": false }
      ] },
    { "name": "automatic only when the rule is switched on",
      "autoRules": [],
      "receipts": [{ "paymentRef": "RA-0020", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" }],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 100, "text": "RA-0020" }],
      "expect": [{ "lineId": "L1", "rule": "reference", "options": 1, "auto": false }] },
    { "name": "an item closed or already matched by the monthly run is not offered",
      "autoRules": ["reference"],
      "receipts": [{ "paymentRef": "RA-0021", "payerKey": "PAYER-A", "amount": 100, "date": "2026-09-01" }],
      "closed": ["ins|RA0021"],
      "lines": [{ "id": "L1", "valueDate": "2026-09-10", "open": 100, "text": "RA-0021" }],
      "expect": [] }
  ]
}
