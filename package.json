{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh && vitest run tests/db",
    "e2e": "playwright test",
    "db:migrate": "supabase migration up && pnpm gen:types",
    "db:reset": "supabase db reset && pnpm gen:types",
    "db:seed": "supabase db reset",
    "gen:types": "supabase gen types typescript --local --schema public > lib/supabase/types.ts",
    "gen:types:url": "supabase gen types typescript --schema public --db-url \"$TEST_DATABASE_URL?sslmode=disable\" > lib/supabase/types.ts",
    "wa:simulate": "tsx scripts/wa-simulate.ts",
    "import:airtable": "tsx scripts/import-airtable.ts",
    "import:sanoflow": "tsx scripts/import-sanoflow.ts",
    "jobs:run": "tsx scripts/run-job.ts",
    "finance:seed": "tsx scripts/seed-finance.ts",
    "finance:replay": "tsx scripts/finance-replay.ts",
    "format": "prettier --write .",
    "audit:security": "tsx scripts/audit-security.ts",
    "load:webhook": "tsx scripts/load/webhook-burst.ts",
    "load:outbound": "tsx scripts/load/outbound-20k.ts",
    "load:mock-graph": "tsx scripts/load/mock-graph.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "cutover:preflight": "tsx scripts/cutover-preflight.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sentry/nextjs": "^11.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.53.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@sentry/cli",
      "@tailwindcss/oxide"
    ]
  }
}
